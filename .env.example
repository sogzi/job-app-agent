# Required: your Anthropic API key (https://platform.claude.com)
ANTHROPIC_API_KEY=

# Optional: Claude model used for analysis (defaults to claude-opus-5-5)
# CLAUDE_MODEL=claude-opus-5-5

# Optional: Supabase. When both are set, applications are stored in Supabase.
# When unset, they are stored in .data/applications.json (local dev only).
# Use the service role key: it is only read on the server, never sent to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
